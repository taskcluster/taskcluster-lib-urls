{
  "name": "taskcluster-lib-urls",
  "version": "13.1.0",
  "author": "Brian Stack <bstack@mozilla.com>",
  "description": "Build urls for taskcluster resources.",
  "license": "MPL-2.0",
  "scripts": {
    "lint": "biome check",
    "pretest": "yarn lint",
    "test": "mocha test/*_test.js",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "files": [
    "src/index.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/taskcluster/taskcluster-lib-urls.git"
  },
  "main": "./src/index.js",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "js-yaml": "^5.0.0",
    "mocha": "^12.0.0"
  },
  "renovate": {
    "extends": [
      "config:base"
    ],
    "packageRules": [
      {
        "updateTypes": [
          "minor",
          "patch"
        ],
        "matchCurrentVersion": "!/^0/",
        "paths": [
          "+(package.json)"
        ],
        "automerge": true
      }
    ]
  }
}
